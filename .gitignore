# Personal Claude Code tooling (research MCP server etc.) — unrelated to
# this project, deliberately not published. See git history if this repo
# ever tracked it before.
/Claude-rules
/Claude-rules-src
/.mcp.json
/.claude/agents

# Rust build artifacts
/tartarus_driver/target

# tasks/ dev-only working notes: reverse-engineering research write-ups,
# raw USB/HID capture logs, ad-hoc test transcripts, and the self-generated
# run.log. Kept locally for reference but deliberately not published.
# TASKS.md itself is tracked (see the negation below) since it's the
# actively-maintained task tracker, not disposable working notes — also
# excluded from the public release separately, see
# scripts/make-public-release-zip.ps1's $ExcludeFromPublic.
/tasks/*
!/tasks/TASKS.md

# Extracted Interception.zip (downloaded driver installer, not project source)
/Interception/

# Personal key remap config, generated/edited via `configui` — everyone's
# actual layout will differ, so this is a per-machine file, not project
# source. See config.example.toml for the documented schema/defaults.
/config.toml

# Output of scripts/make-public-release-zip.ps1
/dist/
