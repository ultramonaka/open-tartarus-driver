# Personal Claude Code tooling (research MCP server etc.) — unrelated to
# this project, deliberately not published. See git history if this repo
# ever tracked it before.
/Claude-rules
/Claude-rules-src
/.mcp.json
/.claude/agents

# Rust build artifacts
/tartarus_driver/target

# logs/ holds only the self-generated run.log (created on first launch,
# capped at ~5MiB, never meant to be committed). The task tracker
# (TASKS.md) and research write-ups/evidence live under docs/ instead,
# which is tracked normally and excluded from the public release as a
# whole — see scripts/make-public-release-zip.ps1's $ExcludeFromPublic.
/logs/*

# Extracted Interception.zip (downloaded driver installer, not project source)
/Interception/

# interception.dll copied next to a locally-built exe for manual testing
# (target/release, target/debug, or here at the crate root) — deliberately
# not bundled/committed, a licensing choice (see Cargo.toml's comment on
# the `interception` dependency).
interception.dll

# Personal key remap config, generated/edited via `configui` — everyone's
# actual layout will differ, so this is a per-machine file, not project
# source. See config.example.toml for the documented schema/defaults.
/config.toml

# Output of scripts/make-public-release-zip.ps1
/dist/
